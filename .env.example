# cPanel supplies PORT automatically. It is only needed for local development.
PORT=5000
NODE_ENV=production

# Database
DB_USER=your_mongodb_user
DB_PASS=your_mongodb_password

# Authentication: generate a long random value and keep it private.
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret

# Frontend URLs used by CORS
FRONTEND_URL=https://kolystore.com
CLIENT_URL=https://kolystore.com

# Gmail / Nodemailer
MAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
NODEMAILER_USER=your-gmail@gmail.com
NODEMAILER_PASS=your-16-character-gmail-app-password
MAIL_FROM=KolyStore <your-gmail@gmail.com>
# Optional: receives new-order notifications.
ADMIN_EMAIL=your-admin-email@example.com

# Cloudinary image hosting
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# DeepL translation (optional; use a DeepL API key, not a browser key)
DEEPL_API_KEY=your_deepl_api_key
